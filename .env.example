# Copy to .env and adjust. Every value below is optional — shown values are the defaults.

# ---------- MCP server ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# http (streamable HTTP, used in Docker) | stdio
SERVER_TRANSPORT=http
LOG_LEVEL=INFO
# What the knowledge base is about (used in MCP tool descriptions; empty = default text
# about 3D printing). Change it when you index a different document set.
KB_TOPIC=

# ---------- LLM (external API, needed only by ask_question) ----------
# ollama | openai (any OpenAI-compatible API: LM Studio, vLLM, llama.cpp server, OpenAI)
LLM_PROVIDER=ollama
# Ollama on the host machine:         http://host.docker.internal:11434
# Ollama from `--profile local-llm`:  http://ollama:11434
# LM Studio on the host:              http://host.docker.internal:1234/v1  (with LLM_PROVIDER=openai,
#                                     e.g. LLM_MODEL=qwen/qwen3-4b, LLM_PROMPT_SUFFIX=/no_think)
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=
# Default: Qwen3-4B-Instruct-2507 (no reasoning mode). Do not use the bare Ollama tag
# `qwen3:4b`: it is the Thinking-2507 model, reasoning cannot be switched off.
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TEMPERATURE=0
# Per request, including time queued on the server (CPU: parallel grading requests queue)
LLM_TIMEOUT_S=300
# Appended to every user prompt. For hybrid qwen3 models served by LM Studio set /no_think:
# reasoning makes each call ~15x slower with no gain for grading. Ollama ignores it.
LLM_PROMPT_SUFFIX=
# Ollama only: context window (tokens) requested for each call
LLM_NUM_CTX=8192
# Reply length caps (tokens). A small model in JSON mode can otherwise loop for thousands
# of tokens; LLM_TIMEOUT_S does not stop a streaming reply.
LLM_MAX_TOKENS=1024
# rewrite / grade / broaden replies (short JSON)
LLM_JSON_MAX_TOKENS=384

# ---------- Embeddings ----------
# local  — fastembed (ONNX) inside the container, model baked into the image
# ollama — Ollama /api/embed (e.g. bge-m3, nomic-embed-text)
# openai — OpenAI-compatible /v1/embeddings
# chroma — ChromaDB default (all-MiniLM-L6-v2, English only)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Defaults to LLM_BASE_URL / LLM_API_KEY when empty
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16

# ---------- Storage ----------
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=knowledge_base

# ---------- Indexing ----------
MAX_FILE_SIZE_KB=1024
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Indexing runs in the background. index_folder waits up to INDEX_WAIT_S seconds for it
# to finish (small folders), otherwise returns at once; progress is shown by index_status.
INDEX_WAIT_S=5

# ---------- Retrieval (hybrid BM25 + vector, Reciprocal Rank Fusion) ----------
RETRIEVE_K=6
MAX_TOP_K=50
# Depth of each ranked list (BM25, vector) before fusion; >= MAX_TOP_K
FETCH_K=50
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5
RRF_C=60

# ---------- Corrective RAG graph ----------
# Generate once at least MIN_RELEVANT graded-relevant chunks are found
MIN_RELEVANT=2
# Max broaden-query -> retrieve loops
MAX_RETRIES=2
# Chunk text is truncated to this length before grading
GRADE_MAX_CHARS=1500
# Parallel grading requests (Ollama serves them per OLLAMA_NUM_PARALLEL)
GRADE_CONCURRENCY=4
# Max characters of relevant chunks passed to the answer prompt
MAX_CONTEXT_CHARS=6000
# If the grader accepts nothing, chunks ranked within the top N of BOTH the BM25 and the
# vector list still go to the answer, marked low_confidence (0 = say "not found")
FALLBACK_MAX_RANK=10
# Adjacent chunks (same file, index +/- N) of relevant chunks are added to the answer
# context while MAX_CONTEXT_CHARS allows (0 = off)
CONTEXT_NEIGHBORS=1
# Before answering, ask the LLM whether the found facts cover every part of the question;
# if not, broaden the search for the missing part
COMPLETENESS_CHECK=true
